<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CHAMA-YETU | Smart, Automated Merry-Go-Round Savings</title>
  <!-- Fonts: Poppins (headings) and Inter (text) from Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Poppins:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/styles.css">
</head>
<body>

  <!-- ============ HEADER ============ -->
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <img class="logo-icon" src="assets/images/icons8-teamwork-100.png" alt="CHAMA-YETU Logo">
        <span>
          <span class="logo-name">CHAMA-YETU</span>
        </span>
      </a>

      <nav class="nav" id="main-nav">
        <a href="#how-it-works" class="nav-link nav-link-active">How It Works</a>
        <a href="#features" class="nav-link">Features</a>
        <a href="#security" class="nav-link">Security</a>
        <a href="#contact" class="nav-link">Contact</a>

        <!-- Only visible on small screens (inside the dropdown) -->
        <div class="nav-actions">
          <a href="/login" class="login-link">Log In</a>
          <a href="/register" class="btn btn-green btn-small">Start Chama</a>
        </div>
      </nav>

      <!-- Hidden on small screens (moved into the nav above) -->
      <div class="header-actions">
        <a href="/login" class="login-link">Log In</a>
        <a href="/register" class="btn btn-green btn-small">Start Chama</a>
      </div>

      <!-- Menu button: only visible on small screens -->
      <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
        <img src="assets/images/icons8-menu-100.png" alt="Menu Icon" class="menu-icon">
      </button>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        
        <h1>Smart, Automated <span class="green-text">Merry-Go-Round</span> Savings</h1>
        <p>Instant M-Pesa STK contributions, scheduled payouts, and zero manual record-keeping.</p>
        <a href="/register" class="btn btn-green">Start Chama →</a>
       
      </div>

      <!-- Direct M-Pesa flow card -->
      <div class="flow-card">
        <p class="flow-title">DIRECT M-PESA FLOW</p>
        <div class="flow-steps">
          <div class="flow-step flow-step-green">
            <strong>1. Prompt</strong>
            <span>Direct STK push to phone</span>
          </div>
          <div class="flow-step">
            <strong>2. Auto Disburse</strong>
            <span>Straight to recipient</span>
          </div>
          <div class="flow-step">
            <strong>3. Zero Fees</strong>
            <span>Full pot kept intact</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ POPULAR CHAMA TYPES ============ -->
  <section class="section section-lavender">
    <div class="container">
      <div class="section-head center">
        <span class="badge badge-blue">FLEXIBLE FOR EVERY GROUP</span>
        <h2>Popular Chama Types</h2>
        <p>Pick a model that fits your savings circle with automated cycle rotations.</p>
      </div>
      <div class="grid grid-4">
        <div class="card">
          <img class="icon icon-blue" src="/assets/images/icons8-family-100.png" alt="family-img">
          <h3>Family Rotations</h3>
          <p>Scheduled monthly payouts with automated reminders for kin and relatives.</p>
        </div>
        <div class="card">
          <span class="icon icon-green">▤</span>
          <h3>Market Traders</h3>
          <p>Daily or weekly micro-contributions settled direct to merchant lines.</p>
        </div>
        <div class="card">
          <span class="icon icon-blue">▦</span>
          <h3>Office Groups</h3>
          <p>Salary-day payouts with instant PDF export and audit-ready records.</p>
        </div>
        <div class="card">
          <span class="icon icon-gold">⌂</span>
          <h3>Table Banking</h3>
          <p>Segregated emergency pots alongside regular merry-go-round cycles.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section section-white" id="how-it-works">
    <div class="container">
      <div class="section-head center">
        <h2>Three Simple Steps</h2>
        <p>Automate your group without envelopes, paperwork, or awkward follow-ups.</p>
      </div>
      <div class="grid grid-4">
        <div class="card">
          <span class="step-number step-blue">01</span>
          <h3>Create Chama</h3>
          <p>Set member limits, contribution dates, and rotation order in minutes.</p>
        </div>
        <!-- NEW: Join Chama step (change the wording to suit you) -->
        <div class="card">
          <span class="step-number step-blue">02</span>
          <h3>Join Chama</h3>
          <p>Join an existing chama with an invite and take your place in the rotation.</p>
        </div>
        <div class="card">
          <span class="step-number step-green">03</span>
          <h3>M-Pesa STK Push</h3>
          <p>Members get a prompt on payment day and authorize with their PIN.</p>
        </div>
        <div class="card">
          <span class="step-number step-gold">04</span>
          <h3>Instant Payout</h3>
          <p>The scheduled recipient receives the pooled pot instantly via B2C.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ KEY FEATURES ============ -->
  <section class="section section-lavender" id="features">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">KEY FEATURES</span>
        <h2>Designed for Treasurers &amp; Members</h2>
        <p>Built specifically for Kenyan chama groups.</p>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <span class="icon icon-blue">↻</span>
          <h3>Flexible Rotations</h3>
          <p>Set custom or randomized rotation cycles with transparent member rosters.</p>
        </div>
        <div class="card">
          <span class="icon icon-green">▤</span>
          <h3>Real-Time Ledger</h3>
          <p>Live balance and payment tracking for every member with instant PDF export.</p>
        </div>
        <div class="card">
          <span class="icon icon-blue">✉</span>
          <h3>Automated Chasers</h3>
          <p>Polite SMS and WhatsApp reminders sent automatically before deadlines.</p>
        </div>
        <div class="card">
          <span class="icon icon-gold">◉</span>
          <h3>Emergency Sub-Pots</h3>
          <p>Manage welfare and emergency side-funds alongside core rotations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SECURITY ============ -->
  <section class="section section-white" id="security">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">SAFETY GUARANTEED</span>
        <h2>Institutional Trust &amp; Security</h2>
        <p>Engineered under Central Bank of Kenya guidelines with enterprise fintech security.</p>
      </div>
      <div class="grid grid-4">
        <div class="card">
          <span class="icon icon-blue">⛨</span>
          <h3>256-Bit SSL Encryption</h3>
          <p>Bank-grade data safety guarding credential transfer and all ledger entries.</p>
          <span class="tick">✓ TLS 1.3 Certified</span>
        </div>
        <div class="card">
          <span class="icon icon-blue">✲</span>
          <h3>Safaricom Daraja API</h3>
          <p>Official direct integration guaranteeing legitimate C2B STK pushes and B2C rails.</p>
          <span class="tick">✓ Zero Intermediaries</span>
        </div>
        <div class="card">
          <span class="icon icon-blue">⚖</span>
          <h3>ODPC Kenya Compliant</h3>
          <p>Strict adherence to Office of the Data Protection Commissioner guidelines.</p>
          <span class="tick">✓ Data Act 2019</span>
        </div>
        <div class="card">
          <span class="icon icon-blue">☑</span>
          <h3>Multi-Sign Approvals</h3>
          <p>Dual authorization protocol requiring both Treasurer &amp; Secretary sign-offs.</p>
          <span class="tick">✓ 2-Key Disbursal Guard</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CALL TO ACTION BANNER ============ -->
  <section class="cta-wrap section-lavender">
    <div class="container">
      <div class="cta">
        <div class="cta-text">
          <span class="icon icon-darkgreen">$</span>
          <h2>Modernize Your Merry-Go-Round Today</h2>
          <p>Join Kenyans saving smarter together. Zero setup fee, start in under 2 minutes.</p>
        </div>
        <div class="cta-buttons">
          <a href="/register" class="btn btn-green">Start Your Chama Now →</a>
          <a href="tel:+254707215959" class="btn btn-dark"><img class="btn-icon" src="assets/images/icons8-agent-100.png" alt="agent-pic"> Speak with Chama Advisor</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <%- include('partials/footer') %>
  
<script src="assets/chama.js"></script>

</body>
</html>